# ---------------------------------------------------------------------------
# Adobe Stock Tracker - environment configuration
# Copy this file to server/.env (all values are optional, safe defaults exist).
# ---------------------------------------------------------------------------

# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=4000

# ---------------------------------------------------------------------------
# Official Adobe Stock API provider (in-app asset data)
# Get a free API key at https://developer.adobe.com/stock/docs/getting-started/02-register-app
# ---------------------------------------------------------------------------

# REQUIRED to populate the full dashboard (asset grid + stats). Sent as the
# "x-api-key" header. When empty, the app runs in "search-link" mode: it shows
# an "API not connected" message and buttons that open Adobe's own
# stock.adobe.com search pages in a new tab. No data is ever fabricated.
# ADOBE_STOCK_API_KEY is the canonical name; ADOBE_API_CLIENT_ID is kept as a
# supported alias (ADOBE_STOCK_API_KEY wins if both are set).
ADOBE_STOCK_API_KEY=

# Sent as the "X-Product" header (any string, often "app/version").
# Canonical name is ADOBE_STOCK_PRODUCT; ADOBE_API_PRODUCT is a supported alias.
ADOBE_STOCK_PRODUCT=AdobeStockTracker/1.0

# ---------------------------------------------------------------------------
# My License History (requires an authorized Adobe account, optional)
# The License History page shows ONLY the authenticated user's own license
# history from the official Adobe License History API. It is NEVER another
# contributor's download history.
#
# ADOBE_STOCK_ACCESS_TOKEN is an OAuth access token for the authenticated
# user (sent as "Authorization: Bearer"). Get one for your Adobe Stock
# account (Service Account / OAuth2) and refresh it before it expires.
# ADOBE_API_ACCESS_TOKEN is a supported alias; ADOBE_STOCK_ACCESS_TOKEN wins.
#
# Without a token, the License History page shows a clear "not authorized"
# message instead of data. Without an API key the whole page is unavailable.
ADOBE_STOCK_ACCESS_TOKEN=

# Optional override for the License History endpoint.
# ADOBE_LICENSE_HISTORY_BASE_URL=https://stock.adobe.io/Rest/Libraries/1/Member/LicenseHistory

# Max upstream pages to scan so server-side search/date filtering stays
# bounded and polite (Adobe's License History API cannot filter server-side).
ADOBE_LICENSE_HISTORY_MAX_PAGES=10

# Optional override for the Search/Files endpoint.
# ADOBE_API_BASE_URL=https://stock.adobe.io/Rest/Media/1/Search/Files

# Response locale.
# ADOBE_API_LOCALE=en_US

# Milliseconds to wait for an upstream Adobe Stock request before aborting.
ADOBE_API_TIMEOUT_MS=15000

# Assets per upstream page and max pages fetched for aggregated stats.
ADOBE_API_LIMIT=100
ADOBE_API_MAX_PAGES=5

# Politeness knobs for upstream Adobe requests: max concurrent requests,
# retries for transient failures (429/5xx), and base retry backoff (ms).
ADOBE_REQUEST_CONCURRENCY=2
ADOBE_MAX_RETRIES=2
ADOBE_BACKOFF_BASE_MS=1000

# ---------------------------------------------------------------------------
# Adobe Stock site search links (always available, no credentials needed)
# The backend only GENERATES these URLs (opened in the user's browser); it
# never fetches them. Used by both search modes: creator links use
# "creator_id=…", Asset/Title links use the "k=<query>" search parameter.
# ---------------------------------------------------------------------------

# Base page used to build "View on Adobe Stock" / filter links.
# ADOBE_SEARCH_BASE_URL=https://stock.adobe.com/search

# "limit" parameter used in generated search links.
ADOBE_SEARCH_LIMIT=100

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# How long to keep normalized results in the in-memory cache (ms).
CACHE_TTL_MS=300000

# Basic API rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Data provider used by the backend.
#   (empty)          -> auto: official API when an Adobe API key is set,
#                       otherwise search-link mode (recommended).
#   adobe-stock-api  -> always use the official Adobe Stock API.
#   search-link      -> always use search-link mode (no in-app data).
ADOBE_DATA_PROVIDER=

# ---------------------------------------------------------------------------
# Historical analytics (optional, DB-less by default)
# ---------------------------------------------------------------------------

# Optional PostgreSQL connection string. When set, the historical observation
# index is persisted via Prisma. When empty, a session-only in-memory store is
# used and the UI clearly labels history as not persisted.
# DATABASE_URL=postgresql://user:password@localhost:5432/adobe_stock_tracker

# Background observation job: re-samples tracked creators so trends build up
# over time. Enabled by default; runs shortly after boot, then every interval.
OBSERVATION_SCHEDULER_ENABLED=true
OBSERVATION_START_DELAY_MS=5000
OBSERVATION_INTERVAL_MS=21600000
# Max assets per creator sampled on each job run.
OBSERVATION_PER_CREATOR_LIMIT=100
